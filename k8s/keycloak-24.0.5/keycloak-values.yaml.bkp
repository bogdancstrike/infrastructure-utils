global:
  imageRegistry: "nexus.hera.ro"
production: true
proxy: passthrough
logging:
  level: DEBUG
replicaCount: 1
image:
  repository: bitnami/keycloak
  tag: 24.0.5-debian-12-r3
  debug: true
auth:
  adminUser: admin
  existingSecret: keycloak-admin
  passwordSecretKey: KEYCLOAK_ADMIN_PASSWORD
tls:
  enabled: true
  existingSecret: "keycloak-mtls"
  usePem: true
service:
  http:
    enabled: false
  type: ClusterIP
networkPolicy:
  enabled: false
serviceAccount:
  automountServiceAccountToken: true
postgresql:
  enabled: false
externalDatabase:
  host: "pg-perso-ha.postgresdb"
  port: 5432
  database: keycloak
  existingSecret: keycloak-external-db
  existingSecretUserKey: user
  existingSecretPasswordKey: password
ingress:
  enabled: true
  ingressClassName: nginx
  hostname: keycloak.hera.ro
  servicePort: https
  annotations:
    nginx.ingress.kubernetes.io/backend-protocol: HTTPS
    nginx.ingress.kubernetes.io/force-ssl-redirect: "true"
    kubernetes.io/ingress.class: nginx
    cert-manager.io/cluster-issuer: vault-tls-clusterissuer
    cert-manager.io/common-name: keycloak.hera.ro
  tls: true
adminIngress:
  enabled: false
  ingressClassName: nginx
  hostname: keycloak-admin.hera.ro
  servicePort: https
  annotations:
    nginx.ingress.kubernetes.io/backend-protocol: HTTPS
    nginx.ingress.kubernetes.io/force-ssl-redirect: "true"
    kubernetes.io/ingress.class: nginx
    cert-manager.io/cluster-issuer: vault-tls-clusterissuer
    cert-manager.io/common-name: keycloak-admin.hera.ro
  tls: true
keycloakConfigCli:
  configuration: |
    {
      "realm" : "master",
      "attributes": {        
        "frontendUrl": "https://keycloak-admin.hera.ro"
      }
    }
