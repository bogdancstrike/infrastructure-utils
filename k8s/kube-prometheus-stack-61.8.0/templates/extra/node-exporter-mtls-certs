### din secretul creat in acest certificat s-au tls.crt si tls.key si s-au pus pe proxmox pt node_exporter si pe ceph

---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: node-exporter-mtls-certs
  namespace: monitoring
spec:
  secretName: node-exporter-mtls
  issuerRef:
    name: monitoring-mtls-issuer
    kind: Issuer
  commonName: cluster.local
  ipAddresses:
    - 127.0.0.1
  dnsNames:
    - node-exporter
    - node-exporter.monitoring
    - node-exporter.monitoring.svc
    - node-exporter.monitoring.svc.cluster.local
  isCA: false
  privateKey:
    algorithm: RSA
    encoding: PKCS8
    size: 2048
  additionalOutputFormats:
  - type: DER
  duration: 2160h0m0s
  renewBefore: 2100h0m0s
  subject:
    countries:
      - RO
    organizations:
      - Hera-mTLS
  usages:
    - digital signature
    - key encipherment
    - server auth
    - key agreement