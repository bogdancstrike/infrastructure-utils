Pentru a configura mTLS la o aplicatie, se creeaza in vault rolul, politica si auth ul:

# din cli dashboard
vault write pki_int_mtls/roles/monitoring_mtls allowed_domains="cluster.local,prometheus,prometheus.monitoring,prometheus.monitoring.svc,prometheus.monitoring.svc.cluster.local,loki,loki.monitoring,loki.monitoring.svc,loki.monitoring.svc.cluster.local,node-exporter,node-exporter.monitoring,node-exporter.monitoring.svc,node-exporter.monitoring.svc.cluster.local,grafana,grafana.monitoring,grafana.monitoring.svc,grafana.monitoring.svc.cluster.local" allow_subdomains=true allow_bare_domains=true


### from vault pod: kubectl -n vault exec -it vault-0 -- sh
vault policy write monitoring_mtls - <<EOF
path "pki_int_mtls*"                        { capabilities = ["read", "list"] }
path "pki_int_mtls/sign/monitoring_mtls"    { capabilities = ["create", "update"] }
path "pki_int_mtls/issue/monitoring_mtls"   { capabilities = ["create"] }
EOF

# din cli dashboard
### Role for mtls vault pods - k8s auth
vault write auth/kubernetes/role/monitoring_mtls_issuer \
    bound_service_account_names=vault-auth \
    bound_service_account_namespaces=monitoring \
    policies=monitoring_mtls \
    ttl=24h

in helm chart urile aplicatiei in templates/extra/certs.yaml:

---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: vault-auth
  namespace: monitoring
---
apiVersion: cert-manager.io/v1
kind: Issuer
metadata:
  name: monitoring-mtls-issuer
  namespace: monitoring
spec:
  vault:
    server: https://vault.vault:8200
    path: pki_int_mtls/sign/monitoring_mtls
    caBundle: 
    auth:
      kubernetes:
        role: monitoring_mtls_issuer
        mountPath: /v1/auth/kubernetes
        serviceAccountRef:
          name: vault-auth
---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: monitoring-mtls-certs
  namespace: monitoring
spec:
  secretName: monitoring-mtls
  issuerRef:
    name: monitoring-mtls-issuer
    kind: Issuer
  commonName: cluster.local
  ipAddresses:
    - 127.0.0.1
  dnsNames:
    - prometheus
    - prometheus.monitoring
    - prometheus.monitoring.svc
    - prometheus.monitoring.svc.cluster.local
    - loki
    - loki.monitoring
    - loki.monitoring.svc
    - loki.monitoring.svc.cluster.local
    - node-exporter
    - node-exporter.monitoring
    - node-exporter.monitoring.svc
    - node-exporter.monitoring.svc.cluster.local
    - grafana
    - grafana.monitoring
    - grafana.monitoring.svc
    - grafana.monitoring.svc.cluster.local
  isCA: false
  privateKey:
    algorithm: RSA 
    encoding: PKCS8
    size: 2048
  additionalOutputFormats:
  - type: DER
  duration: 2160h0m0s
  renewBefore: 2100h0m0s
  subject:
    countries:
      - RO
    organizations:
      - Hera-mTLS
  usages:
    - digital signature
    - key encipherment
    - server auth
    - key agreement





